datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model TeamMember {
  id          String   @id @default(uuid())
  name        String
  role        String
  email       String   @unique
  shortBio    String
  fullBio     String
  education   String
  image       String
  cover       String   // মেম্বারের ছবি বা কভার ছবির পাথ
  facebook    String
  linkedin    String
  instagram   String
  website     String
  order       Int      @default(0)
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Store {
  id            String   @id @default(uuid())
  name          String
  category      String
  rating        Float    @default(5.0)
  reviewsCount  Int      @default(0)
  address       String
  timing        String
  phone         String
  logo          String?  // ? মানে অপশনাল
  coverImage    String?  // ? মানে অপশনাল
  isFeatured    Boolean  @default(false)
  isVerified    Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}